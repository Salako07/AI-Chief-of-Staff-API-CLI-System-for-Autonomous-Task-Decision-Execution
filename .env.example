# AI Chief of Staff - Environment Configuration

# ============================================================================
# OpenAI API Configuration
# ============================================================================
# Your OpenAI API key (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use for AI agents
OPENAI_MODEL=gpt-4o-mini

# Temperature for AI generation (0.0-1.0, lower = more deterministic)
OPENAI_TEMPERATURE=0.2

# ============================================================================
# Slack Integration (Optional)
# ============================================================================
# Slack incoming webhook URL for notifications
# Get webhook from: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# Example:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# ============================================================================
# Quality Control Settings
# ============================================================================
# Minimum quality score threshold (set in code: app/services/processor.py:19)
# MIN_QUALITY_SCORE=5

# Maximum retry attempts (default: 2, meaning 3 total attempts)
# MAX_RETRIES=2

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory (relative to project root)
LOG_DIR=logs

# ============================================================================
# Database Configuration (Future Use)
# ============================================================================
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# Database name
DB_NAME=ai_chief_of_staff

# ============================================================================
# API Configuration
# ============================================================================
# API server host
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# Enable API debug mode (not recommended for production)
API_DEBUG=false

# ============================================================================
# Celery + Redis Configuration (Async Execution)
# ============================================================================
# Redis connection URL for Celery task queue
# Default: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Celery broker (same as Redis URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (same as Redis URL)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Worker concurrency (number of parallel tasks per worker)
# Recommended: 2-4 for single machine, 10+ for production
CELERY_WORKER_CONCURRENCY=4

# ============================================================================
# DigitalOcean Spaces Configuration (Cloud Storage)
# ============================================================================
# AWS-compatible credentials for DigitalOcean Spaces
# Get credentials from: https://cloud.digitalocean.com/account/api/tokens
AWS_ACCESS_KEY_ID=your-spaces-access-key-here
AWS_SECRET_ACCESS_KEY=your-spaces-secret-key-here

# Spaces bucket name (create bucket at https://cloud.digitalocean.com/spaces)
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Spaces region (nyc3, sfo3, sgp1, fra1, ams3, etc.)
# See regions: https://docs.digitalocean.com/products/spaces/
AWS_S3_REGION_NAME=nyc3

# Spaces endpoint URL (auto-generated from region)
# Format: https://{region}.digitaloceanspaces.com
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# ============================================================================
# Media Processing Configuration
# ============================================================================
# Use DigitalOcean Spaces for video storage (true/false)
# If false, videos are stored on local disk
USE_SPACES_STORAGE=true

# Access control for uploaded videos (private or public-read)
# private = generate presigned URLs for access
# public-read = videos publicly accessible without authentication
SPACES_ACL=private

# Video retention period in days (how long to keep videos before cleanup)
# Default: 30 days
SPACES_RETENTION_DAYS=30

# Maximum upload file size in MB
# Set to unlimited (no size restrictions)
# MAX_UPLOAD_SIZE_MB=unlimited

# Local temp directory for video downloads/processing
MEDIA_UPLOAD_DIR=/tmp/media_uploads
